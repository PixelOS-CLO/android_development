digraph G {
    fontname="Helvetica,Arial,sans-serif";
    node [fontname="Helvetica,Arial,sans-serif", shape=box, style="rounded,filled"];
    edge [fontname="Helvetica,Arial,sans-serif"];

    subgraph cluster_graph {
        label = "Object Graph";
        GCRoot [label="GC Root", fillcolor="#fbb4ae"];
        A [label="A", fillcolor="#ccebc5"];
        B [label="B", fillcolor="#ccebc5"];
        C [label="C", fillcolor="#ccebc5"];
        D [label="D", fillcolor="#ccebc5"];
        E [label="E", fillcolor="#decbe4"];

        GCRoot -> A;
        GCRoot -> B;
        A -> C;
        A -> D;
        B -> D;
        C -> E;
        D -> E;
    }

    subgraph cluster_tree {
        label = "Dominator Tree";
        GCRoot_T [label="GC Root", fillcolor="#fbb4ae"];
        A_T [label="A", fillcolor="#ccebc5"];
        B_T [label="B", fillcolor="#ccebc5"];
        C_T [label="C", fillcolor="#ccebc5"];
        D_T [label="D", fillcolor="#ccebc5"];
        E_T [label="E", fillcolor="#decbe4"];

        GCRoot_T -> A_T;
        GCRoot_T -> B_T;
        GCRoot_T -> D_T;
        A_T -> C_T;
        GCRoot_T -> E_T;
    }
}
